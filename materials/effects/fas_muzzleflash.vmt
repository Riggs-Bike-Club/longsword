// Stand-in for the Firearms: Source game material of the same name; reuses the fas_muzzleflash_test_b flash sheet.
"SpriteCard"
{
	$basetexture "effects/fas_muzzleflash_test_b"
	$SEQUENCE_BLEND_MODE 1
	$MAXLUMFRAMEBLEND1 0
	$MAXLUMFRAMEBLEND2 1
	$depthblend 1
	$STARTFADESIZE 3
	$ENDFADESIZE 4.5
	"$additive" 1
	"$vertexcolor" 1
	"$vertexalpha" 1
}
